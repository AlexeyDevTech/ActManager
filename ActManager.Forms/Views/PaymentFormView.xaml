<UserControl x:Class="ActManager.Forms.Views.PaymentFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prism="http://prismlibrary.com/"             
             prism:ViewModelLocator.AutoWireViewModel="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Payment Form" FontSize="20" FontWeight="Bold"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,10" Orientation="Horizontal">
            <TextBlock Text="Contract" Width="100"/>
            <ComboBox Width="200" 
                     ItemsSource="{Binding Contracts}"
                     SelectedItem="{Binding SelectedContract}"
                     DisplayMemberPath="TenantName"/>
            <Button Content="Browse Contracts" 
                   Command="{Binding ShowContractsCommand}"
                   Margin="10,0,0,0"/>
            <Button Content="Add Contract" 
                   Command="{Binding AddContractCommand}"
                   Margin="10,0,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="Amount"/>
            <TextBox Text="{Binding Amount}"/>
        </StackPanel>

        <!-- Остальные существующие поля -->
        <!-- ... -->
        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock Text="Payment Date"/>
            <DatePicker SelectedDate="{Binding PaymentDate}"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,0,0,10">
            <TextBlock Text="Due Date"/>
            <DatePicker SelectedDate="{Binding DueDate}"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Margin="0,0,0,10">
            <TextBlock Text="Status"/>
            <ComboBox Text="{Binding Status}">
                <ComboBoxItem Content="Pending"/>
                <ComboBoxItem Content="Completed"/>
                <ComboBoxItem Content="Overdue"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="6" Margin="0,0,0,10">
            <TextBlock Text="Source"/>
            <TextBox Text="{Binding Source}" IsReadOnly="True"/>
        </StackPanel>
        <!-- Диалог для контрактов -->
        <Popup IsOpen="{Binding IsContractDialogOpen}"
               Placement="Center"
               AllowsTransparency="True">
            <Border Background="White" 
                   BorderBrush="Gray" 
                   BorderThickness="1"
                   Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" 
                              Text="Contracts" 
                              FontSize="16" 
                              Margin="0,0,0,10"/>

                    <DataGrid Grid.Row="1" 
                             ItemsSource="{Binding Contracts}"
                             SelectedItem="{Binding SelectedContract}"
                             AutoGenerateColumns="False"
                             MinHeight="200"
                             MaxWidth="600">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}"/>
                            <DataGridTextColumn Header="Tenant" Binding="{Binding TenantName}"/>
                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount}"/>
                            <DataGridTextColumn Header="Start Date" Binding="{Binding StartDate}"/>
                            <DataGridTextColumn Header="End Date" Binding="{Binding EndDate}"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Grid.Row="2" 
                           Content="Close" 
                           Command="{Binding ShowContractsCommand}"
                           HorizontalAlignment="Right"
                           Margin="0,10,0,0"/>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
