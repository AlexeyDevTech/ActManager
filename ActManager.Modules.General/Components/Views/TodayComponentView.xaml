<UserControl x:Class="ActManager.Modules.General.Components.Views.TodayComponentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ActManager.Modules.General.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:core="clr-namespace:ActManager.Core;assembly=ActManager.Core"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:ActManager.Modules.General.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:TodayComponentViewModel}"
             d:DesignHeight="208" d:DesignWidth="260"
             xmlns:prism="http://prismlibrary.com/"             
             prism:ViewModelLocator.AutoWireViewModel="True">
    <UserControl.DataContext>
        <vm:TodayComponentViewModel/>
    </UserControl.DataContext>
    <Grid Background="WhiteSmoke">
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition/>
            <RowDefinition Height="20"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="3*"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Text="Сегодня" Foreground="#333" TextAlignment="Center" FontSize="20" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="1" Text="{Binding Day}" Foreground="#333" TextAlignment="Center" FontSize="72" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="2" Text="{Binding Month}" Foreground="#333" TextAlignment="Center" VerticalAlignment="Center" FontSize="20"/>
        </Grid>
    </Grid>
</UserControl>
