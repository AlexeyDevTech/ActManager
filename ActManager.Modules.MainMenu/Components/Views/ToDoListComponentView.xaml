<UserControl
    x:Class="ActManager.Modules.MainMenu.Components.Views.ToDoListComponentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:ActManager.Modules.MainMenu.Components.Converters"
    xmlns:core="clr-namespace:ActManager.Core;assembly=ActManager.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ActManager.Modules.MainMenu.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:vm="clr-namespace:ActManager.Modules.MainMenu.Components.ViewModels"
    d:DataContext="{d:DesignInstance vm:ToDoListComponentViewModel}"
    d:DesignHeight="316"
    d:DesignWidth="1380"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#333" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ItemSettingButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#333" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="#CCC" />
            <Setter Property="Opacity" Value="0.15" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.6" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.9" />
                                <Setter Property="Background" Value="#CCC" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PriorityTextStyle" TargetType="{x:Type TextBlock}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Priority}" Value="1">
                    <Setter Property="Foreground" Value="#FF88CC95" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Priority}" Value="2">
                    <Setter Property="Foreground" Value="#FFAFC300" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Priority}" Value="3">
                    <Setter Property="Foreground" Value="#FFC33C32" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ImagePriorityStyle" TargetType="Image">
            <Setter Property="Width" Value="25" />
            <Setter Property="Height" Value="25" />
            <Setter Property="Opacity" Value="0.5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Priority}" Value="1">
                    <Setter Property="Source" Value="/ActManager.Modules.MainMenu;component/Resources/low-priority-50.png" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Priority}" Value="2">
                    <Setter Property="Source" Value="/ActManager.Modules.MainMenu;component/Resources/mid-priority-50.png" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Priority}" Value="3">
                    <Setter Property="Source" Value="/ActManager.Modules.MainMenu;component/Resources/high-priority-50.png" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <conv:AlternationToBrushConverter x:Key="AlternationToBrushConverter" />
        <conv:NameShortenerConverter x:Key="ShorterConverter" />
        <conv:EnumDescriptionConverter x:Key="EnumConverter" />
    </UserControl.Resources>

    <Grid d:Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="25" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,17,0">
            <Grid.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#666" />
                    <Setter Property="Margin" Value="5,0,0,0" />
                    <Setter Property="FontSize" Value="16" />
                </Style>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.6*" />
                <ColumnDefinition />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition />
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <TextBlock Text="ID" />
            <TextBlock Grid.Column="1" Text="ДАТА" />
            <TextBlock Grid.Column="2" Text="ЗАДАЧА" />
            <TextBlock Grid.Column="3" Text="КЛИЕНТ" />
            <TextBlock
                Grid.Column="4"
                HorizontalAlignment="Center"
                Text="ПРИОРИТЕТ" />
            <TextBlock
                Grid.Column="5"
                HorizontalAlignment="Center"
                Text="СТАТУС" />
            <TextBlock Grid.Column="6" />
        </Grid>

        <ScrollViewer Grid.Row="1">
            <ItemsControl
                x:Name="ToDoListControl"
                AlternationCount="2"
                ItemsSource="{Binding Goals}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="ContentControl.Background" Value="White" />
                        <Setter Property="ContentControl.FontSize" Value="14" />
                        <Setter Property="ContentControl.Foreground" Value="#444" />
                        <Setter Property="ContentControl.FontFamily" Value="Tahoma" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid
                            Name="ListEl"
                            Height="50"
                            Margin="5,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.6*" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="{Binding ID, StringFormat=#{0}}" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="01.04.2025" />
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Text="{Binding Title}" />
                            <TextBlock Grid.Column="3" VerticalAlignment="Center">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource ShorterConverter}">
                                        <Binding Path="Customer.FirstName" />
                                        <Binding Path="Customer.SecondName" />
                                        <Binding Path="Customer.ThirdName" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <!--<TextBlock Style="{DynamicResource PriorityTextStyle}" Grid.Column="4" VerticalAlignment="Center" TextAlignment="Center" Text="{Binding Priority}"/>-->
                            <Image Grid.Column="4" Style="{DynamicResource ImagePriorityStyle}" />
                            <Grid Grid.Column="5">
                                <Border x:Name="StatusField">
                                    <Border.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FFEDEDED" />
                                            <Setter Property="Margin" Value="10" />
                                            <Setter Property="CornerRadius" Value="15" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="1">
                                                    <Setter Property="Background" Value="#FFF4F9BD" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="2">
                                                    <Setter Property="Background" Value="#FFCFF6FF" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="3">
                                                    <Setter Property="Background" Value="#FFCAFDCA" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="10">
                                                    <Setter Property="Background" Value="#FFFFD6D6" />
                                                </DataTrigger>
                                            </Style.Triggers>

                                        </Style>
                                    </Border.Resources>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Text="{Binding Status, Converter={StaticResource EnumConverter}}"
                                        TextAlignment="Center" />
                                </Border>
                            </Grid>
                            <!--<TextBlock Grid.Column="5" VerticalAlignment="Center" TextAlignment="Right"  Text="{Binding Status}"/>-->
                            <Grid Grid.Column="6" HorizontalAlignment="Right">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Button
                                    Grid.Column="0"
                                    Margin="11,11,0,11"
                                    Style="{DynamicResource ItemSettingButton}"
                                    ToolTip="Отложить задачу">
                                    <Image Margin="2" Source="/ActManager.Modules.MainMenu;component/Resources/pending-100.png" />
                                </Button>
                                <Button
                                    Grid.Column="1"
                                    Margin="0,11"
                                    Style="{DynamicResource ItemSettingButton}"
                                    ToolTip="Выполнить задачу">
                                    <Image Margin="2" Source="/ActManager.Modules.MainMenu;component/Resources/done-100.png" />
                                </Button>
                                <Button
                                    Grid.Column="2"
                                    Margin="0,11,11,11"
                                    Style="{DynamicResource ItemSettingButton}"
                                    ToolTip="Закрыть задачу">
                                    <Image Margin="2" Source="/ActManager.Modules.MainMenu;component/Resources/cancel-100.png" />
                                </Button>
                            </Grid>
                            <Rectangle
                                Grid.Column="0"
                                Grid.ColumnSpan="7"
                                Height="1"
                                VerticalAlignment="Bottom"
                                Fill="#FFCCCCCC" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </Grid>

</UserControl>
