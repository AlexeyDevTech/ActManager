<UserControl
    x:Class="ActManager.Modules.MainMenu.Components.Views.NotificationComponentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:ActManager.Modules.MainMenu.Components.Converters"
    xmlns:core="clr-namespace:ActManager.Core;assembly=ActManager.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="250"
    d:DesignWidth="1704"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">
    <UserControl.Resources>
        <conv:BooleanToBrushConverter x:Key="BooleanTobrushConverter" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    </UserControl.Resources>
    <Grid>
        <Border
            Margin="10,0"
            Background="White"
            CornerRadius="20">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="80" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="Tahoma"
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="#333"
                            Text="Уведомления" />
                        <Border
                            Grid.RowSpan="1"
                            Grid.Column="1"
                            Margin="15,0"
                            Padding="10,0"
                            HorizontalAlignment="Left"
                            Background="#FFE7F0FF"
                            CornerRadius="16">
                            <Grid>
                                <TextBlock
                                    Grid.Column="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    d:Text="99999"
                                    FontFamily="Tahoma"
                                    FontSize="14"
                                    Foreground="#FF465AB9"
                                    Text="{Binding NotificationCount}" />
                            </Grid>
                        </Border>
                    </Grid>
                    <TextBlock
                        Grid.Row="1"
                        VerticalAlignment="Center"
                        FontFamily="Tahoma"
                        FontSize="16"
                        Foreground="#999"
                        Text="Будьте в курсе новостей" />
                    <Button
                        Grid.Row="0"
                        Grid.RowSpan="2"
                        Grid.Column="4"
                        Height="30">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}">
                                <Setter Property="Background" Value="#FFE7F0FF" />

                                <Setter Property="Margin" Value="5" />
                                <Setter Property="BorderThickness" Value="0.5" />
                                <Setter Property="BorderBrush" Value="#CCC" />
                                <Setter Property="Opacity" Value="0.6" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                Padding="{TemplateBinding Padding}"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Opacity" Value="0.9" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Opacity" Value="1" />
                                                    <Setter Property="Background" Value="#FFD3DCEB" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.2" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <TextBlock
                                FontFamily="Tahoma"
                                FontWeight="Bold"
                                Foreground="#FF465AB9"
                                Text="Фильтр уведомлений" />
                        </Grid>
                    </Button>
                </Grid>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <ScrollViewer Grid.ColumnSpan="5">
                        <ItemsControl ItemsSource="{Binding NotificationList}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Border
                                            Margin="5"
                                            Padding="10"
                                            Background="{Binding IsRead, Converter={StaticResource BooleanTobrushConverter}, ConverterParameter=Read:#FFFFFF;Unread:#F0F0F0}"
                                            BorderBrush="Gray"
                                            BorderThickness="1"
                                            CornerRadius="5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel>
                                                    <TextBlock
                                                        FontWeight="Bold"
                                                        Foreground="{Binding IsRead, Converter={StaticResource BooleanTobrushConverter}, ConverterParameter=Read:Gray;Unread:Black}"
                                                        Text="{Binding Type}" />
                                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                                    <TextBlock
                                                        FontSize="12"
                                                        Foreground="Gray"
                                                        Text="{Binding EventDate, StringFormat='dd.MM.yyyy HH:mm'}" />
                                                </StackPanel>

                                                <TextBlock
                                                    Grid.Column="1"
                                                    Text="{Binding RelatedEntityId, StringFormat='ID: {0}'}"
                                                    Visibility="{Binding RelatedEntityId, Converter={StaticResource NullToVisibilityConverter}}" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>

        </Border>
    </Grid>
</UserControl>
