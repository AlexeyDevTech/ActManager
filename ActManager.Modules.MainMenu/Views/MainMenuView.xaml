<UserControl
    x:Class="ActManager.Modules.MainMenu.Views.MainMenuView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="clr-namespace:ActManager.Core;assembly=ActManager.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ActManager.Modules.MainMenu.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="1704"
    d:DesignWidth="1400"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ActManager.Core;component/Resources/StyleDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="NegativeProp" Color="#FFC19999" />
            <SolidColorBrush x:Key="PositiveLightColor" Color="#FFC1DFC1" />
            <SolidColorBrush x:Key="PositiveColor" Color="#FF99C199" />
            <SolidColorBrush x:Key="PositiveAccentColor" Color="#FF49AD49" />
            <GridLength x:Key="HorizontalMarginWidth">0.2*</GridLength>

        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden">
        <Grid d:Background="#FFE7E9EB">
            <Grid.RowDefinitions>
                <RowDefinition Height="90" />
                <RowDefinition Height="140" />
                <RowDefinition Height="20" />
                <RowDefinition Height="300" />
                <RowDefinition Height="20" />
                <RowDefinition Height="340" />
                <RowDefinition Height="20" />
                <RowDefinition Height="394" />
                <RowDefinition Height="60" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="93,0">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="30"
                    Foreground="#999"
                    Text="Здравствуйте, Екатерина!">
                    <!--<TextBlock.Foreground>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <GradientStop Color="Black"/>
                            <GradientStop Color="#FFE7E9EB" Offset="0.775"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </LinearGradientBrush>
                    </TextBlock.Foreground>-->
                </TextBlock>
            </Grid>
            <Grid Name="MainMenuTopBoard" Grid.Row="1">
                <Grid.Resources>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="White" />
                        <Setter Property="Margin" Value="10,0" />
                        <Setter Property="CornerRadius" Value="20" />
                    </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{DynamicResource HorizontalMarginWidth}" />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition Width="{DynamicResource HorizontalMarginWidth}" />
                </Grid.ColumnDefinitions>
                <ContentControl Grid.Column="1" prism:RegionManager.RegionName="MainMenuHeadItem1" />
                <ContentControl Grid.Column="2" prism:RegionManager.RegionName="MainMenuHeadItem2" />
                <ContentControl Grid.Column="3" prism:RegionManager.RegionName="MainMenuHeadItem3" />
            </Grid>
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{DynamicResource HorizontalMarginWidth}" />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition Width="{DynamicResource HorizontalMarginWidth}" />
                </Grid.ColumnDefinitions>
                <ContentControl
                    Grid.Column="1"
                    Grid.ColumnSpan="3"
                    prism:RegionManager.RegionName="NotificationComponentRegion" />
            </Grid>
            <Grid Grid.Row="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{DynamicResource HorizontalMarginWidth}" />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition Width="{DynamicResource HorizontalMarginWidth}" />
                </Grid.ColumnDefinitions>
                <ContentControl
                    Grid.Column="1"
                    Grid.ColumnSpan="3"
                    prism:RegionManager.RegionName="PaymentComponentRegion" />
            </Grid>
            <Grid x:Name="ListMenuBoard" Grid.Row="7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{DynamicResource HorizontalMarginWidth}" />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition Width="{DynamicResource HorizontalMarginWidth}" />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    Grid.ColumnSpan="3"
                    Margin="10,0"
                    Background="White"
                    CornerRadius="20">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="80" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,20">
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="Tahoma"
                                FontSize="18"
                                FontWeight="Bold"
                                Foreground="#333"
                                Text="Список задач" />
                            <TextBlock
                                Grid.Row="1"
                                VerticalAlignment="Center"
                                FontFamily="Tahoma"
                                FontSize="16"
                                Foreground="#999"
                                Text="Задачи сегодняшнего дня" />
                            <Button
                                Grid.Row="0"
                                Grid.RowSpan="2"
                                Grid.Column="4"
                                Height="30">
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}">
                                        <Setter Property="Background" Value="#FFE7F0FF" />

                                        <Setter Property="Margin" Value="5" />
                                        <Setter Property="BorderThickness" Value="0.5" />
                                        <Setter Property="BorderBrush" Value="#CCC" />
                                        <Setter Property="Opacity" Value="0.6" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border
                                                        Padding="{TemplateBinding Padding}"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="8">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Opacity" Value="0.9" />
                                                            <Setter Property="BorderThickness" Value="1" />
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter Property="Opacity" Value="1" />
                                                            <Setter Property="Background" Value="#FFD3DCEB" />
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Opacity" Value="0.2" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <Grid>
                                    <TextBlock
                                        FontFamily="Tahoma"
                                        FontWeight="Bold"
                                        Foreground="#FF465AB9"
                                        Text="Добавить задачу" />
                                </Grid>
                            </Button>
                        </Grid>
                        <ContentControl
                            Grid.Row="1"
                            MaxHeight="304"
                            prism:RegionManager.RegionName="MainMenuToDoListRegion" />
                    </Grid>

                </Border>
            </Grid>
            <Grid Grid.Row="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{DynamicResource HorizontalMarginWidth}" />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition Width="{DynamicResource HorizontalMarginWidth}" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="1" Grid.ColumnSpan="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="4">
                        <TextBlock
                            Margin="0,0,30,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontFamily="Tahoma"
                            FontSize="14"
                            Foreground="#FF9A9A9A"
                            Text="v0.0.4" />
                        <TextBlock
                            Margin="10,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontFamily="Tahoma"
                            FontSize="14"
                            Foreground="#FF9A9A9A"
                            Text="@By_Prozorov" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
