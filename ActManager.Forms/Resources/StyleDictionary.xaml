<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:ActManager.Forms.Converters">
    <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <conv:EnumDescriptionConverter x:Key="EnumDescriptionConverter" />

    <SolidColorBrush x:Key="NegativeProp" Color="#FFC19999" />
    <SolidColorBrush x:Key="PositiveLightColor" Color="#FFC1DFC1" />
    <SolidColorBrush x:Key="PositiveColor" Color="#FF99C199" />
    <SolidColorBrush x:Key="PositiveAccentColor" Color="#FF49AD49" />

    <!--  Стиль карточки здания  -->
    <Style x:Key="BuildingCardButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="150" />
        <Setter Property="Height" Value="120" />
        <Setter Property="Margin" Value="5" />
        <Setter Property="Background" Value="#CCC" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect
                    BlurRadius="15"
                    Opacity="0.6"
                    Color="Black" />
            </Setter.Value>
        </Setter>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="15">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#BBB" />
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect
                                        BlurRadius="10"
                                        Opacity="0.5"
                                        Color="Black" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Background" Value="#FF969696" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Verdana" />
        <Setter Property="FontSize" Value="14" />
    </Style>
    <DataTemplate x:Key="EnumDescriptionTemplate">
        <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
    </DataTemplate>
</ResourceDictionary>