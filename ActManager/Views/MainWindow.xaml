<Window x:Class="ActManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:core="clr-namespace:ActManager.Core;assembly=ActManager.Core"
        prism:ViewModelLocator.AutoWireViewModel="True"
        Title="{Binding Title}" Height="900" Width="1800" MinWidth="1060" >
    <Window.Resources>
        <Style TargetType="Button" x:Key="CollapseButtonStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border BorderBrush="White" BorderThickness="1,1,1,1" CornerRadius="5,5,5,5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF37424F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Storyboard x:Key="CollapseAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Width.Value"
                             To="280" Duration="0:0:0.3"/>
        </Storyboard>
        <Storyboard x:Key="ExpandAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Width.Value"
                             To="800" Duration="0:0:0.3"/>
        </Storyboard>
    </Window.Resources>
    <Grid Background="#FF25303E">
        <Grid.RowDefinitions>
            <RowDefinition Height="68"/>
            <RowDefinition Height="30"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <ContentControl Grid.Row="0" prism:RegionManager.RegionName="{x:Static core:RegionNames.HeaderRegion}" Margin="5"/>
        <ContentControl Grid.Row="1" prism:RegionManager.RegionName="InfoBoardRegion"/>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="C0" Width="8*" MinWidth="280" MaxWidth="600"/>
                <!--<ColumnDefinition Width="5"/>-->
                <ColumnDefinition Width="11*" MinWidth="500"/>
                <!--<ColumnDefinition Width="5"/>-->
                <ColumnDefinition Width="8*" MinWidth="280" MaxWidth="600"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="5" x:Name="LeftBoardGrid">
                <ContentControl Grid.Column="0" prism:RegionManager.RegionName="{x:Static core:RegionNames.LeftBoardRegion}" />
                <Button x:Name="leftCollapseButton" Style="{StaticResource CollapseButtonStyle}" Width="30" Height="30" Background="Transparent" VerticalAlignment="Top" HorizontalAlignment="Right" Foreground="White" Margin="0,10,10,0" Click="Button_Click">
                    <Button.Content>
                        <Grid Width="28" Height="28" Background="Transparent">
                            <Path Data="M 18,7 L 7,14 L18,21 Z" Stroke="White" StrokeThickness="2" Fill="White" />
                        </Grid>
                    </Button.Content>
                </Button>
            </Grid>
            <Grid Grid.Column="1" Margin="5">
                <ContentControl Grid.Column="1" prism:RegionManager.RegionName="{x:Static core:RegionNames.ContentRegion}" Margin="5" />
            </Grid>
            <Grid Grid.Column="2" Margin="5">
                <ContentControl Grid.Column="2" prism:RegionManager.RegionName="{x:Static core:RegionNames.RightBoardRegion}" Margin="5"/>
            </Grid>


            
            
            
        </Grid>
    </Grid>
</Window>
