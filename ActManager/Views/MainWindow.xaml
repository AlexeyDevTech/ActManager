<Window x:Class="ActManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prism="http://prismlibrary.com/"
        prism:ViewModelLocator.AutoWireViewModel="True"
        Title="{Binding Title}" Height="900" Width="1800" >
    <Grid Background="#FF25303E">
        <Grid.RowDefinitions>
            <RowDefinition Height="68"/>
            <RowDefinition Height="30"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <ContentControl Grid.Row="0" prism:RegionManager.RegionName="HeaderRegion" Margin="5"/>
        <ContentControl Grid.Row="1" prism:RegionManager.RegionName="InfoBoardRegion"/>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="8*"/>
                <!--<ColumnDefinition Width="5"/>-->
                <ColumnDefinition Width="11*"/>
                <!--<ColumnDefinition Width="5"/>-->
                <ColumnDefinition Width="8*"/>
            </Grid.ColumnDefinitions>
            <ContentControl Grid.Column="0" prism:RegionManager.RegionName="LeftBoardRegion" Margin="5"/>
            <!--<Border Grid.Column="1" Background="Black" BorderThickness="0.5,0,0.5,0" BorderBrush="White"/>-->
            <ContentControl Grid.Column="1" prism:RegionManager.RegionName="ContentRegion" Margin="5" />
           <!--<Border Grid.Column="3" Background="Black" BorderThickness="0.5,0,0.5,0" BorderBrush="White"/>-->
            <ContentControl Grid.Column="2" prism:RegionManager.RegionName="RightBoardRegion" Margin="5"/>
        </Grid>
    </Grid>
</Window>
