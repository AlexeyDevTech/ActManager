<Window x:Class="ActManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:core="clr-namespace:ActManager.Core;assembly=ActManager.Core"
        prism:ViewModelLocator.AutoWireViewModel="True"
        Title="{Binding Title}" Height="1000" Width="1500" ResizeMode="CanMinimize">
    <Window.Resources>
        
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Panel.ZIndex="3">
            <Border Background="#FF31373A">
                <Border.Effect>
                    <DropShadowEffect Direction="10" BlurRadius="10" ShadowDepth="2"/>
                </Border.Effect>
                <Grid>
                    <ContentControl prism:RegionManager.RegionName="{x:Static core:RegionNames.LeftBoardRegion}"/>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="#FFF1F3F5">
                <Border BorderBrush="DarkGray" BorderThickness="0,0,0,1">
                    <ContentControl prism:RegionManager.RegionName="{x:Static core:RegionNames.HeaderRegion}"/>
                </Border>
                
            </Grid>
            <Grid Grid.Row="1" Background="#FFE7E9EB">
                <!--<Image Source="/Resources/bg.jpg" Stretch="Fill" Opacity="0.3"/>-->
                <ContentControl prism:RegionManager.RegionName="{x:Static core:RegionNames.ContentRegion}"/>
            </Grid>
        </Grid>
        <!-- Overlay для затемнения -->
        <Border Grid.ColumnSpan="2" x:Name="Overlay" 
                Background="#FF3A3A3A" 
                Opacity="0.5"
                Visibility="Hidden" MouseDown="Overlay_MouseDown"/>
        <Grid Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Right" Width="600"
              Background="#F0F0F0">
            <Grid.Effect>
                <DropShadowEffect x:Name="ShadowRightRegion" ShadowDepth="3" 
                  Direction="270"
                  BlurRadius="15"
                  Opacity="1" Color="Black"/>
            </Grid.Effect>
            <Grid.RenderTransform>
                <TranslateTransform x:Name="PanelTransform" X="600"/>
            </Grid.RenderTransform>
            <ContentControl prism:RegionManager.RegionName="RightPanelRegion"/>
        </Grid>

    </Grid>
</Window>
